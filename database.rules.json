{
  "rules": {
    ".read": "auth != null && auth.token.email == 'idontsayidontsay@gmail.com'",
    ".write": "auth != null && auth.token.email == 'idontsayidontsay@gmail.com'",
    "papers": {
      ".read": true,
      ".write": "auth != null && (auth.token.email == 'idontsayidontsay@gmail.com' || auth.token.email == 'larpgio@gmail.com')",
      "$paperId": {
        ".write": "auth != null",
        "views": {
          ".write": true
        },
        "savedCount": {
          ".write": "auth != null"
        }
      }
    },
    "tags": {
      ".read": true,
      ".write": "auth != null && (auth.token.email == 'idontsayidontsay@gmail.com' || auth.token.email == 'larpgio@gmail.com')"
    },
    "requests": {
      ".read": "auth != null && (auth.token.email == 'idontsayidontsay@gmail.com' || auth.token.email == 'larpgio@gmail.com')",
      ".write": "newData.exists() || (auth != null && (auth.token.email == 'idontsayidontsay@gmail.com' || auth.token.email == 'larpgio@gmail.com'))"
    },
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || auth.token.email == 'idontsayidontsay@gmail.com')",
        ".write": "auth != null && (auth.uid == $uid || auth.token.email == 'idontsayidontsay@gmail.com')"
      }
    },
    "announcements": {
      ".read": "auth != null && auth.token.email == 'idontsayidontsay@gmail.com'",
      ".write": "auth != null && auth.token.email == 'idontsayidontsay@gmail.com'"
    }
  }
}