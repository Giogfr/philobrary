{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/t/:slug",
      "destination": "/t/:slug/index.html"
    },
    {
      "source": "/p/:slug",
      "destination": "/p/:slug/index.html"
    },
    {
      "source": "/ka/p/:slug",
      "destination": "/ka/p/:slug/index.html"
    },
    {
      "source": "/ru/p/:slug",
      "destination": "/ru/p/:slug/index.html"
    },
    {
      "source": "/pl/p/:slug",
      "destination": "/pl/p/:slug/index.html"
    },
    {
      "source": "/he/p/:slug",
      "destination": "/he/p/:slug/index.html"
    },
    {
      "source": "/ar/p/:slug",
      "destination": "/ar/p/:slug/index.html"
    },
    {
      "source": "/es/p/:slug",
      "destination": "/es/p/:slug/index.html"
    },
    {
      "source": "/fr/p/:slug",
      "destination": "/fr/p/:slug/index.html"
    },
    {
      "source": "/de/p/:slug",
      "destination": "/de/p/:slug/index.html"
    },
    {
      "source": "/it/p/:slug",
      "destination": "/it/p/:slug/index.html"
    },
    {
      "source": "/pt/p/:slug",
      "destination": "/pt/p/:slug/index.html"
    },
    {
      "source": "/tr/p/:slug",
      "destination": "/tr/p/:slug/index.html"
    },
    {
      "source": "/ja/p/:slug",
      "destination": "/ja/p/:slug/index.html"
    },
    {
      "source": "/zh/p/:slug",
      "destination": "/zh/p/:slug/index.html"
    },
    {
      "source": "/uk/p/:slug",
      "destination": "/uk/p/:slug/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
